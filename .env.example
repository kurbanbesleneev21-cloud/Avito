# ---------- Server ----------
PORT=3000
NODE_ENV=production
# Public URL of the site (used in sitemap, canonical/OG tags, notification links)
SITE_URL=https://codeforge.dev
# Set to true when running behind a reverse proxy (nginx, Render, Railway…) so client IPs are correct
TRUST_PROXY=true
# Random string, at least 32 characters:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# ---------- Admin ----------
ADMIN_USER=admin
# Generate with:  npm run hash-password
ADMIN_PASSWORD_HASH=
# (dev only) plain password instead of hash
# ADMIN_PASSWORD=

# ---------- Database ----------
# Empty = built-in SQLite file in ./data (zero setup).
# PostgreSQL / Supabase connection string switches storage to Postgres:
# DATABASE_URL=postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres
DATABASE_URL=
# Where SQLite DB and uploaded files are stored
DATA_DIR=data

# ---------- Anti-spam ----------
# Reject e-mails whose domain has no MX/A records
EMAIL_MX_CHECK=true
# Max order submissions per IP per hour
ORDER_RATE_LIMIT=6

# ---------- Telegram notifications ----------
# 1) Create a bot with @BotFather  2) write to the bot  3) get chat id via https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- E-mail notifications (SMTP) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="CODEFORGE <no-reply@codeforge.dev>"
# Team inbox that receives new orders
MAIL_NOTIFY_TO=
# Send "we received your order" e-mail to the client
MAIL_CLIENT_CONFIRMATION=true
